name: Build Android APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  android:
    runs-on: ubuntu-22.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Xvfb (for real error output)
        shell: bash
        run: sudo apt-get update && sudo apt-get install -y xvfb

      - name: Install Android SDK packages
        shell: bash
        run: |
          set -e
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager --sdk_root="$ANDROID_HOME" \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0" \
            "cmdline-tools;latest"
          adb version
          adb start-server

      - name: Download Godot 4.5.1 and export templates
        shell: bash
        run: |
          set -e
          wget -q https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_linux.x86_64.zip -O godot.zip
          unzip -q godot.zip -d godot_tmp
          mkdir -p godot
          mv godot_tmp/Godot_v4.5.1-stable_linux.x86_64 godot/godot
          chmod +x godot/godot

          wget -q https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_export_templates.tpz -O templates.tpz
          mkdir -p "$HOME/.local/share/godot/export_templates/4.5.1.stable"
          unzip -q templates.tpz -d /tmp/godot_templates
          cp -r /tmp/godot_templates/templates/* "$HOME/.local/share/godot/export_templates/4.5.1.stable/"
          test -f "$HOME/.local/share/godot/export_templates/4.5.1.stable/android_release.apk"
          test -f "$HOME/.local/share/godot/export_templates/4.5.1.stable/android_debug.apk"

      - name: Configure Godot Android paths
        shell: bash
        run: |
          set -e
          mkdir -p "$HOME/.config/godot"
          cat > "$HOME/.config/godot/editor_settings-4.5.tres" <<EOF_SETTINGS
          [gd_resource type="EditorSettings" format=3]

          [resource]

          export/android/java_sdk_path = "$JAVA_HOME"
          export/android/android_sdk_path = "$ANDROID_HOME"
          export/android/shutdown_adb_on_exit = true
          export/android/force_system_user = false
          EOF_SETTINGS
          # Some Godot CI setups still look for the non-minor filename.
          cp "$HOME/.config/godot/editor_settings-4.5.tres" "$HOME/.config/godot/editor_settings-4.tres"

      - name: Create Android debug keystore
        shell: bash
        run: |
          set -e
          keytool -genkeypair -v \
            -keystore "$HOME/debug.keystore" \
            -storepass android \
            -keypass android \
            -alias androiddebugkey \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -dname "CN=Android Debug, OU=Android, O=Android, L=Unknown, ST=Unknown, C=US"
          test -s "$HOME/debug.keystore"

      - name: Create Android export preset
        shell: bash
        run: |
          set -e
          cat > export_presets.cfg <<EOF_PRESET
          [preset.0]
          name="Android"
          platform="Android"
          runnable=true
          dedicated_server=false
          custom_features=""
          export_filter="all_resources"
          include_filter=""
          exclude_filter=""
          export_path="build/schoolfemboy-runaway.apk"
          patch_list=PackedStringArray()

          [preset.0.options]
          custom_template/debug=""
          custom_template/release=""
          gradle_build/use_gradle_build=false
          package/unique_name="com.schoolfemboy.runaway"
          package/name="SchoolFemboy Runaway"
          package/signed=false
          keystore/debug="$HOME/debug.keystore"
          keystore/debug_user="androiddebugkey"
          keystore/debug_password="android"
          keystore/release=""
          keystore/release_user=""
          keystore/release_password=""
          package/app_category=2
          version/code=1
          version/name="0.1.0"
          screen/orientation=1
          architectures/arm64-v8a=true
          architectures/armeabi-v7a=false
          architectures/x86=false
          architectures/x86_64=false
          EOF_PRESET
          test -f export_presets.cfg
          grep -F 'package/signed=false' export_presets.cfg
          grep -F "keystore/debug=\"$HOME/debug.keystore\"" export_presets.cfg

      - name: Import project
        shell: bash
        run: xvfb-run -a ./godot/godot --headless --editor --path . --import --quit

      - name: Validate Android export configuration
        shell: bash
        run: |
          set -e
          xvfb-run -a ./godot/godot --headless --path . --export-debug Android build/schoolfemboy-runaway.apk --verbose

      - name: Verify APK
        shell: bash
        run: |
          set -e
          test -s build/schoolfemboy-runaway.apk
          ls -lh build/schoolfemboy-runaway.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: schoolfemboy-runaway-apk
          path: build/schoolfemboy-runaway.apk
