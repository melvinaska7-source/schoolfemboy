name: Build Android APK
on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build with Godot
        uses: abarichello/godot-export@master
        with:
          godot_version: 4.5.1
          project_path: ./
          export_path: ./build/app.apk
          export_debug: false
          export_filter: Android
          relative_export_path: ./build/

      - name: Upload APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: schoolfemboy-runaway-apk
          path: ./build/app.apk