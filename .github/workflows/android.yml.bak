name: Build Android APK
on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  android:
    runs-on: ubuntu-22.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android packages
        run: |
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "cmdline-tools;latest"

      - name: Download Godot
        run: |
          wget -q https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_linux.x86_64.zip -O godot.zip
          unzip -q godot.zip -d godot
          mv godot/Godot_v4.5.1-stable_linux.x86_64 godot/godot
          chmod +x godot/godot
          wget -q https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_export_templates.tpz -O templates.tpz
          mkdir -p ~/.local/share/godot/export_templates/4.5.1.stable
          unzip -q templates.tpz -d /tmp/godot_templates
          cp -r /tmp/godot_templates/templates/* ~/.local/share/godot/export_templates/4.5.1.stable/

      - name: Create build directory
        run: mkdir -p build

      - name: Create Android export preset
        run: |
          cat > export_presets.cfg <<'EOF'
          [preset.0]
          name="Android"
          platform="Android"
          runnable=true
          custom_features=""
          export_filter="all_resources"
          include_filter=""
          exclude_filter=""
          export_path="build/schoolfemboy-runaway.apk"
          patch_list=PackedStringArray()
          [preset.0.options]
          custom_template/debug=""
          custom_template/release=""
          gradle_build/use_gradle_build=false
          package/unique_name="com.schoolfemboy.runaway"
          package/name="SchoolFemboy Runaway"
          package/signed=false
          package/app_category=2
          version/code=1
          version/name="0.1.0"
          screen/orientation=1
          architectures/arm64-v8a=true
          architectures/armeabi-v7a=false
          architectures/x86_64=false
          EOF

      - name: Import project
        run: ./godot/godot --headless --editor --path . --quit 2>&1 | tee import.log

      - name: Check import log
        run: cat import.log

      - name: Export APK
        run: |
          echo "Starting export..."
          ./godot/godot --headless --path . --export-release Android build/schoolfemboy-runaway.apk 2>&1 | tee export.log
          EXPORT_STATUS=$?
          echo "Export status code: $EXPORT_STATUS"
          echo ""
          echo "=== EXPORT LOG ==="
          cat export.log
          echo ""
          echo "=== BUILD DIRECTORY ==="
          ls -lah build/
          echo ""
          echo "=== FIND ALL APK ==="
          find . -name "*.apk"
          echo ""
          echo "=== CHECK IF APK EXISTS ==="
          if [ -f build/schoolfemboy-runaway.apk ]; then
            echo "✅ APK FOUND!"
            file build/schoolfemboy-runaway.apk
            ls -lah build/schoolfemboy-runaway.apk
          else
            echo "❌ APK NOT FOUND"
          fi

      - name: Debug - Upload build directory
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: debug-build-directory
          path: build/
          if-no-files-found: ignore

      - name: Debug - Upload logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: debug-logs
          path: "*.log"
          if-no-files-found: ignore